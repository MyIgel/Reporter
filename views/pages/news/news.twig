{% extends 'pages/news/news.twig' %}
{% import 'reporter/report.twig' as r %}

{% block comment_mod %}
    {% if is_guest() or comment.user.id != user.id %}

        {{ r.report({
            'comment': comment.text,
            'at': comment.created_at,
            'id': comment.id,
            'user': comment.user.id,
        }, {'class': 'me-1'}) }}

    {% endif %}

    {{ parent() }}
{% endblock %}
